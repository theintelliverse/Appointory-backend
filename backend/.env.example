PORT=5000
MONGO_URL=your_mongodb_connection_string
# Optional fallback key
MONGODB_URI=
JWT_SECRET=your_jwt_secret
FRONTEND_URL=http://localhost:5173
# Comma-separated list for extra allowed origins (e.g. admin panel, staging URLs)
CORS_ORIGINS=http://localhost:5173

EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
# Deployed Vercel email service URL (PRIMARY sender)
EMAIL_SERVICE_URL=https://your-email-service.vercel.app/api/send
# Shared secret to protect the email service endpoint
EMAIL_SERVICE_SECRET=your_shared_secret_here

TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_whatsapp_number
TWILIO_PHONE_NUMBER=your_twilio_phone_number
# Preferred key used by SMS controllers (fallback to TWILIO_SID in WhatsApp helper)
TWILIO_ACCOUNT_SID=your_twilio_account_sid

CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 🌐 SEO & Server-Side Rendering (SSR) Configuration
PUBLIC_SITE_URL=https://appointory.in
FRONTEND_INDEX_PATH=../frontend/dist/index.html

